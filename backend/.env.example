# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé anon / publishable : utilisée uniquement pour la connexion Auth
SUPABASE_ANON_KEY=VOTRE_CLE_PUBLISHABLE
# Clé secrète/service_role : serveur uniquement, JAMAIS dans le frontend ou Git
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SECRETE

# En local, le frontend est servi depuis un serveur statique (ex. Live Server)
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501
NODE_ENV=development
